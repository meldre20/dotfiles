#!/bin/bash

sleep_minutes=30
wallpaper_dir="$HOME/Pictures/Wallpaper/.feh_slideshow"

cycle_pictures() {
    find "$wallpaper_dir" -type f \( -iname "*.jpg" -o -iname "*.jpeg" -o -iname "*.png" \) | shuf | while read -r FILE; do
        if [ -f "$FILE" ]; then
            feh --bg-fill "$FILE"
            # Asynchronously update betterlockscreen cache at idle CPU priority
            nice -n 19 betterlockscreen -u "$FILE" --fx dimblur >/dev/null 2>&1 &
            sleep $(( 60 * sleep_minutes ))
        fi
    done
}

while true; do
    cycle_pictures
done
