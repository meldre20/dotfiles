#!/bin/bash

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/workmode"
STATE_PATH="$STATE_DIR/state"

mkdir -p "$STATE_DIR"

if [ ! -f "$STATE_PATH" ]; then
    echo "on" > "$STATE_PATH"
    echo "Work mode initialized: on"
    exit 0
fi

current_mode=$(head -n 1 "$STATE_PATH")

case "$current_mode" in
    "on")
        sudo mv /etc/hosts /etc/hosts.work.bak
        sudo mv /etc/hosts.play.bak /etc/hosts
        echo "off" > "$STATE_PATH"
        echo "Work mode: off"
        ;;
    "off")
        sudo mv /etc/hosts /etc/hosts.play.bak
        sudo mv /etc/hosts.work.bak /etc/hosts
        echo "on" > "$STATE_PATH"
        echo "Work mode: on"
        ;;
    *)
        echo "ERR: Invalid state found in $STATE_PATH. Please fix and try again."
        printf "\tCurrent mode is: %s\n" "$current_mode"
        exit 1
        ;;
esac
